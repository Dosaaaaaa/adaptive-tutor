# Copy this file to .env and fill it in. NEVER commit .env. NEVER paste a key into a chat, a screenshot or a ticket.
# The AI keys are read only from this file, never from the shell environment.

# The teacher's password for the web app (use a long phrase).
TEACHER_PASSWORD=

# Free AI keys. Gemini writes questions, Groq checks them; OpenRouter is an optional fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional, to build quizzes faster (see README.md, "Why a quiz takes minutes"):
# BUILD_WORKERS=3                       # AI calls of one build that may run side by side (1 = one at a time)
# VERIFY_FALLBACK_MODEL=openai/gpt-oss-20b   # a second checking model, used when the first one's free allowance for the day is used up
# VERIFY_FALLBACK_PROVIDER=groq         # defaults to the checker's own provider
# GEN_REASONING=low                     # how hard a thinking model thinks: none | low | medium | high (also VERIFY_REASONING, FALLBACK_REASONING)
# GEMINI_RPM=10                         # requests per minute allowed to each provider (also GROQ_RPM, OPENROUTER_RPM); raise them on a paid plan

# Optional, for a public deployment (see README.md, "Deploy"):
# TUTOR_MODE=all              # all | teacher | student (student = only the exam link, no teacher routes at all)
# PUBLIC_URL=https://exams.example.org
# STUDENT_PORT=8080            # port of the student-only instance (./run_web.sh sets it for the teacher instance)
# COOKIE_SECURE=1             # when served over HTTPS
# TRUST_PROXY=1               # only behind your own reverse proxy
# ALLOWED_ORIGINS=            # extra origins allowed to send state-changing requests
# SESSION_SECRET=             # otherwise one is generated and kept in data/session.key
